<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DroidDock</AssemblyName><Version>0.2.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile><IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MediaDevices" Version="2.0.0" />
    <ProjectReference Include="../DroidDock.Core/DroidDock.Core.csproj" />
    <Content Include="../scripts/*.cmd" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="../../THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="IncludeRuntimeNotices" AfterTargets="Publish" Condition="'$(SelfContained)' == 'true'">
    <Copy SourceFiles="%(ResolvedRuntimePack.PackageDirectory)/LICENSE.TXT" DestinationFolder="$(PublishDir)licenses/%(ResolvedRuntimePack.Identity)" Condition="Exists('%(ResolvedRuntimePack.PackageDirectory)/LICENSE.TXT')" />
    <Copy SourceFiles="%(ResolvedRuntimePack.PackageDirectory)/LICENSE" DestinationFolder="$(PublishDir)licenses/%(ResolvedRuntimePack.Identity)" Condition="Exists('%(ResolvedRuntimePack.PackageDirectory)/LICENSE')" />
    <Copy SourceFiles="%(ResolvedRuntimePack.PackageDirectory)/THIRD-PARTY-NOTICES.TXT" DestinationFolder="$(PublishDir)licenses/%(ResolvedRuntimePack.Identity)" Condition="Exists('%(ResolvedRuntimePack.PackageDirectory)/THIRD-PARTY-NOTICES.TXT')" />
  </Target>
</Project>
